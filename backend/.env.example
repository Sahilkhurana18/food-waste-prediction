# Copy this file to .env and fill in real values.

# Postgres connection string. When running via docker-compose, "db" is the service name.
DATABASE_URL="postgresql://harvestloop:harvestloop@localhost:5432/harvestloop?schema=public"

# Secret used to sign JWTs — use a long random string in real deployments.
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000

# Base URL of the FastAPI ML service. Use the docker-compose service name when containerized.
ML_SERVICE_URL="http://localhost:8001"

# Origin(s) allowed to call this API (your frontend's dev/prod URL).
CORS_ORIGIN="http://localhost:5173"
