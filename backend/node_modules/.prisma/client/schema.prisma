generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESTAURANT
  NGO
  VOLUNTEER
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  CLAIMED
  DELIVERED
  EXPIRED
}

enum RequestStatus {
  PENDING
  MATCHED
  FULFILLED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  DELIVERED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  restaurant Restaurant?
  ngo        NGO?
  volunteer  Volunteer?
}

model Restaurant {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  name      String
  latitude  Float
  longitude Float
  address   String?

  foodRecords FoodRecord[]
  donations   Donation[]
}

model NGO {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  name      String
  latitude  Float
  longitude Float
  capacity  Int?

  requests Request[]
  matches  Match[]
}

model Volunteer {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  name      String
  latitude  Float?
  longitude Float?

  deliveries Delivery[]
}

model FoodRecord {
  id               String     @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id])
  foodName         String
  mealType         String
  date             DateTime
  quantityPrepared Int
  quantitySold     Int
  quantityWasted   Int
  createdAt        DateTime   @default(now())

  @@index([restaurantId, date])
}

model Donation {
  id            String         @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  foodName      String
  quantity      Int
  availableFrom DateTime       @default(now())
  expiresAt     DateTime
  status        DonationStatus @default(AVAILABLE)
  createdAt     DateTime       @default(now())

  match Match?

  @@index([status])
}

model Request {
  id        String        @id @default(uuid())
  ngoId     String
  ngo       NGO           @relation(fields: [ngoId], references: [id])
  foodType  String
  quantity  Int
  urgency   String        @default("normal")
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  matches Match[]
}

model Match {
  id         String   @id @default(uuid())
  donationId String   @unique
  donation   Donation @relation(fields: [donationId], references: [id])
  ngoId      String
  ngo        NGO      @relation(fields: [ngoId], references: [id])
  requestId  String?
  request    Request? @relation(fields: [requestId], references: [id])
  quantity   Int
  distanceKm Float?
  score      Float?
  createdAt  DateTime @default(now())

  delivery Delivery?
}

model Delivery {
  id           String         @id @default(uuid())
  matchId      String         @unique
  match        Match          @relation(fields: [matchId], references: [id])
  volunteerId  String?
  volunteer    Volunteer?     @relation(fields: [volunteerId], references: [id])
  status       DeliveryStatus @default(ASSIGNED)
  pickupTime   DateTime?
  deliveryTime DateTime?
  createdAt    DateTime       @default(now())
}
